<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ala & jiooo · Love Across the Miles</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Playfair+Display:ital,wght@0,500;0,700;1,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,400&display=swap" rel="stylesheet">
  
  <style>
    :root {
      /* Sino-Egyptian Color Palette */
      --cn-red: #c91026;         
      --cn-red-light: #fbe6e8;
      --eg-gold: #d4af37;        
      --eg-lapis: #2a4b7c;       
      --text-main: #2b2021;
      --text-sub: #7a6865;
      --card-bg: rgba(253, 250, 246, 0.85);
      --glass-border: rgba(212, 175, 55, 0.4);
      --shadow-rich: 0 16px 40px -10px rgba(201, 16, 38, 0.15), 0 8px 20px -5px rgba(42, 75, 124, 0.1);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: linear-gradient(135deg, #f9f3e9 0%, #fbe6e8 50%, #eef1f6 100%);
      color: var(--text-main);
      min-height: 100vh;
      overflow-x: hidden;
      padding-bottom: 90px;
    }

    /* Silk Texture Overlay */
    body::before {
      content: ""; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
      background-image: 
        radial-gradient(var(--eg-gold) 0.5px, transparent 0.5px),
        radial-gradient(var(--cn-red) 0.5px, transparent 0.5px);
      background-size: 20px 20px; background-position: 0 0, 10px 10px;
      opacity: 0.08; z-index: -3; pointer-events: none;
    }

    /* Custom Background Layers */
    #bg-image-layer { position: fixed; inset: 0; background-size: cover; background-position: center; z-index: -2; opacity: 0; transition: opacity 0.8s ease; }
    #bg-image-layer.has-image { opacity: 1; }
    #bg-overlay { position: fixed; inset: 0; background: linear-gradient(to bottom, rgba(253, 250, 246, 0.65), rgba(253, 250, 246, 0.9)); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); z-index: -1; opacity: 0; transition: opacity 0.8s ease; pointer-events: none; }
    #bg-overlay.has-image { opacity: 1; }

    #hearts-canvas { position: fixed; inset: 0; pointer-events: none; z-index: 0; }

    .top-actions { position: fixed; top: 20px; right: 20px; z-index: 10; }
    .btn-edit {
      display: inline-flex; align-items: center; gap: 6px; padding: 8px 18px; border-radius: 999px;
      background: rgba(255, 255, 255, 0.9); border: 1px solid var(--glass-border);
      font-size: 13px; font-weight: 700; color: var(--cn-red); cursor: pointer;
      backdrop-filter: blur(10px); box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: all 0.3s ease;
    }
    .btn-edit:hover { background: var(--cn-red); color: #fff; transform: translateY(-2px); }

    .page-section { display: none; width: 100%; max-width: 560px; margin: 30px auto 0; position: relative; z-index: 1; padding: 0 16px; animation: fadeIn 0.5s ease forwards; }
    .page-section.active { display: block; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

    .glass-card {
      background: var(--card-bg); backdrop-filter: blur(25px); -webkit-backdrop-filter: blur(25px);
      border-radius: 28px; padding: 30px 24px; margin-bottom: 20px;
      box-shadow: var(--shadow-rich); border: 1px solid var(--glass-border);
      text-align: center; position: relative; overflow: hidden;
    }
    .glass-card::after { content: ""; position: absolute; top: 0; left: 0; width: 100%; height: 5px; background: linear-gradient(90deg, var(--cn-red), var(--eg-gold), var(--eg-lapis)); }

    /* --- Module 1: Main Timer --- */
    .arabic-title { font-family: 'Amiri', serif; font-size: 26px; color: var(--eg-gold); direction: rtl; margin-bottom: 10px; text-shadow: 0 2px 8px rgba(212, 175, 55, 0.4); }
    .couples-header { display: flex; align-items: center; justify-content: center; gap: 14px; margin-bottom: 15px; }
    .person-name { font-family: 'Playfair Display', serif; font-size: 26px; font-weight: 700; color: var(--text-main); }
    .heart-beat { font-size: 18px; animation: heartbeat 1.5s infinite; filter: drop-shadow(0 0 8px var(--cn-red)); }
    @keyframes heartbeat { 0%, 100% { transform: scale(1); } 25% { transform: scale(1.25); } 50% { transform: scale(1); } 75% { transform: scale(1.15); } }
    
    .subtitle { font-size: 12px; letter-spacing: 3px; color: var(--text-sub); text-transform: uppercase; font-weight: 600; margin-bottom: 5px; }
    .days-num { font-family: 'Playfair Display', serif; font-size: clamp(60px, 15vw, 90px); line-height: 1; font-weight: 700; color: var(--cn-red); text-shadow: 2px 2px 0 rgba(212, 175, 55, 0.3); }
    .days-unit { font-size: 13px; color: var(--text-sub); font-weight: 700; letter-spacing: 4px; margin: 8px 0 20px; }
    .clock-ticker { display: inline-block; padding: 8px 20px; border-radius: 999px; background: rgba(255, 255, 255, 0.8); border: 1px dashed var(--eg-gold); color: var(--eg-lapis); font-variant-numeric: tabular-nums; font-size: 14px; font-weight: 700; }

    /* --- Module 2: Cross-Border Flight (Flags & Accurate Maps) --- */
    .flight-card { display: flex; align-items: center; justify-content: space-between; padding: 30px 16px; }
    
    .location-node { text-align: center; width: 100px; position: relative; display: flex; flex-direction: column; align-items: center; }
    
    /* Accurate Map Silhouettes */
    .map-icon {
      position: absolute;
      top: 50%; left: 50%;
      transform: translate(-50%, -50%);
      width: 120px; height: 120px;
      z-index: 0;
      opacity: 0.25; /* Soft background */
    }
    
    /* Fixed Egypt Map (Using the perfectly working source from version 1) */
    .map-egypt {
      -webkit-mask-image: url('https://cdn.jsdelivr.net/gh/djaiss/mapsicon@master/all/eg/vector.svg');
      mask-image: url('https://cdn.jsdelivr.net/gh/djaiss/mapsicon@master/all/eg/vector.svg');
      -webkit-mask-size: contain; mask-size: contain;
      -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
      -webkit-mask-position: center; mask-position: center;
      background-color: var(--eg-gold);
    }
    
    /* Fixed China Map (Using the fully detailed territory source from version 2) */
    .map-china {
      -webkit-mask-image: url('https://code.highcharts.com/mapdata/countries/cn/cn-all.svg');
      mask-image: url('https://code.highcharts.com/mapdata/countries/cn/cn-all.svg');
      -webkit-mask-size: contain; mask-size: contain;
      -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
      -webkit-mask-position: center; mask-position: center;
      background-color: var(--cn-red);
    }

    .loc-content { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; }
    
    /* National Flags */
    .loc-flag-img {
      width: 44px; height: auto;
      border-radius: 4px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.15);
      margin-bottom: 8px;
    }
    
    .loc-name { font-size: 16px; font-weight: 900; color: var(--eg-lapis); margin-bottom: 6px; }
    .loc-time { font-size: 12px; font-weight: 700; color: var(--text-sub); background: rgba(255,255,255,0.9); padding: 4px 10px; border-radius: 8px; font-variant-numeric: tabular-nums; box-shadow: 0 2px 5px rgba(0,0,0,0.05); }

    .flight-route { flex-grow: 1; position: relative; height: 50px; margin: 0 10px; display: flex; flex-direction: column; justify-content: center; z-index: 2;}
    .distance-lbl { position: absolute; top: -12px; width: 100%; text-align: center; font-size: 12px; color: var(--cn-red); font-weight: 700; letter-spacing: 1px; }
    .route-line { width: 100%; height: 2px; background: repeating-linear-gradient(to right, var(--eg-gold) 0, var(--eg-gold) 6px, transparent 6px, transparent 12px); opacity: 0.8; }
    
    /* Airplane & Cartoon Snacks */
    .plane-wrapper {
      position: absolute; top: 6px; left: 0;
      width: 45px; height: 45px;
      display: flex; align-items: center; justify-content: center;
      animation: flyAround 10s ease-in-out infinite;
      z-index: 5;
    }
    .plane-icon { font-size: 24px; filter: drop-shadow(0 5px 5px rgba(201, 16, 38, 0.4)); z-index: 2; }
    
    .snack-indomie { position: absolute; top: -12px; left: -12px; font-size: 16px; animation: floatSnack 2s ease-in-out infinite alternate; }
    .snack-chips { position: absolute; bottom: -10px; right: -10px; font-size: 16px; animation: floatSnack 2.5s ease-in-out infinite alternate-reverse; }

    @keyframes floatSnack { 0% { transform: translateY(0) rotate(-15deg); } 100% { transform: translateY(-5px) rotate(15deg); } }

    @keyframes flyAround {
      0% { left: 0%; transform: scaleX(1) translateY(0) rotate(10deg); }
      25% { transform: scaleX(1) translateY(-15px) rotate(0deg); }
      48% { left: calc(100% - 35px); transform: scaleX(1) translateY(0) rotate(-10deg); }
      50% { left: calc(100% - 35px); transform: scaleX(-1) translateY(0) rotate(-10deg); } 
      75% { transform: scaleX(-1) translateY(-15px) rotate(0deg); }
      98% { left: 0%; transform: scaleX(-1) translateY(0) rotate(10deg); }
      100% { left: 0%; transform: scaleX(1) translateY(0) rotate(10deg); } 
    }

    /* --- Module 3: Milestones --- */
    .milestones-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 20px; }
    .milestone-card { background: rgba(255, 255, 255, 0.7); border: 1px solid rgba(212, 175, 55, 0.2); border-radius: 18px; padding: 16px 10px; transition: transform 0.3s; }
    .milestone-title { font-size: 12px; color: var(--text-sub); text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 4px; }
    .milestone-countdown { font-size: 13px; font-weight: 600; color: var(--eg-lapis); }
    .milestone-countdown span { font-family: 'Playfair Display', serif; font-size: 20px; color: var(--eg-gold); }
    .quote-box { font-family: 'Cormorant Garamond', serif; font-size: 17px; line-height: 1.6; color: var(--text-main); font-style: italic; padding: 0 10px; }

    /* --- Timeline --- */
    .timeline-container { padding: 10px; }
    .timeline-item { display: flex; gap: 20px; margin-bottom: 30px; position: relative; }
    .timeline-item::before { content: ""; position: absolute; left: 19px; top: 40px; bottom: -30px; width: 2px; background: dashed 2px var(--glass-border); }
    .timeline-item:last-child::before { display: none; }
    .timeline-icon { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--eg-gold), var(--cn-red)); color: white; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0; z-index: 2; box-shadow: 0 4px 10px rgba(201,16,38,0.2); }
    .timeline-content { background: var(--card-bg); padding: 16px; border-radius: 16px; border: 1px solid var(--glass-border); flex-grow: 1; }
    .timeline-date { font-size: 12px; color: var(--eg-gold); font-weight: 700; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.5px;}
    .timeline-title { font-size: 16px; font-weight: 700; color: var(--eg-lapis); margin-bottom: 6px; }
    .timeline-desc { font-size: 13px; color: var(--text-sub); line-height: 1.6; }

    /* Updated Bottom Navigation (Only 2 Tabs) */
    .bottom-nav { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); display: flex; gap: 6px; padding: 8px; border-radius: 999px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(20px); box-shadow: 0 10px 30px rgba(42, 75, 124, 0.15); border: 1px solid rgba(255, 255, 255, 0.8); z-index: 50; }
    .nav-btn { background: transparent; border: none; padding: 10px 32px; border-radius: 999px; font-size: 14px; font-weight: 700; color: var(--text-sub); cursor: pointer; transition: all 0.3s; display: flex; align-items: center; gap: 8px; }
    .nav-btn.active { background: var(--cn-red-light); color: var(--cn-red); box-shadow: 0 2px 8px rgba(201,16,38,0.1); }

    /* Settings Modal */
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.5); backdrop-filter: blur(5px); z-index: 100; display: none; align-items: center; justify-content: center; padding: 16px; }
    .modal-overlay.active { display: flex; }
    .modal-card { background: #fff; border-radius: 24px; padding: 24px; width: 100%; max-width: 400px; border-top: 6px solid var(--eg-gold); }
    .modal-title { font-size: 18px; font-weight: 700; color: var(--eg-lapis); display: flex; justify-content: space-between; margin-bottom: 20px; }
    .modal-title button { background: none; border: none; font-size: 24px; cursor: pointer; color: #ccc; }
    .input-ctrl { width: 100%; padding: 10px; border: 1px solid #eee; border-radius: 12px; font-size: 14px; outline: none; margin-bottom: 12px; font-family: inherit; }
    .input-ctrl:focus { border-color: var(--eg-gold); }
    .btn-save { width: 100%; padding: 12px; background: var(--cn-red); color: #fff; border: none; border-radius: 12px; font-size: 15px; font-weight: 700; cursor: pointer; }
  </style>
</head>
<body>

  <div id="bg-image-layer"></div>
  <div id="bg-overlay"></div>
  <canvas id="hearts-canvas"></canvas>

  <div class="top-actions">
    <button class="btn-edit" id="btn-open-settings">⚙️ Settings</button>
  </div>

  <main id="page-home" class="page-section active">
    
    <!-- Main Timer -->
    <div class="glass-card" style="padding-bottom: 25px;">
      <div class="arabic-title" id="view-arabic-title">نحن معاً إلى الأبد</div>
      <div class="couples-header">
        <span class="person-name" id="view-name1">ala</span>
        <span class="heart-beat">❤️</span>
        <span class="person-name" id="view-name2">jiooo</span>
      </div>
      <div class="subtitle" id="view-status-title">Together for</div>
      <div class="days-num" id="view-days">0</div>
      <div class="days-unit">DAYS</div>
      <div class="clock-ticker" id="view-clock">00h 00m 00s</div>
    </div>

    <!-- Cross-Border Flight (With Flags & Complete Maps) -->
    <div class="glass-card flight-card">
      
      <!-- Egypt Side -->
      <div class="location-node">
        <div class="map-icon map-egypt"></div>
        <div class="loc-content">
          <img src="https://flagcdn.com/w80/eg.png" alt="Egypt Flag" class="loc-flag-img">
          <div class="loc-name">Egypt</div>
          <div class="loc-time" id="time-egypt">--:--</div>
        </div>
      </div>
      
      <div class="flight-route">
        <div class="distance-lbl">Across 7500 km</div>
        <div class="route-line"></div>
        
        <!-- Airplane with Indomie and Chips -->
        <div class="plane-wrapper">
          <span class="cartoon-snack snack-indomie">🍜</span>
          <span class="plane-icon">✈️</span>
          <span class="cartoon-snack snack-chips">🍟</span>
        </div>
      </div>

      <!-- China Side -->
      <div class="location-node">
        <div class="map-icon map-china"></div>
        <div class="loc-content">
          <img src="https://flagcdn.com/w80/cn.png" alt="China Flag" class="loc-flag-img">
          <div class="loc-name">China</div>
          <div class="loc-time" id="time-china">--:--</div>
        </div>
      </div>
      
    </div>

    <div class="glass-card">
      <div class="milestones-grid">
        <div class="milestone-card">
          <span class="milestone-title" id="ms-hundred-title">Next 100 Days</span>
          <span class="milestone-countdown" id="ms-hundred-val">In <span>--</span> days</span>
        </div>
        <div class="milestone-card">
          <span class="milestone-title" id="ms-year-title">Anniversary</span>
          <span class="milestone-countdown" id="ms-year-val">In <span>--</span> days</span>
        </div>
      </div>
      <div class="quote-box" id="view-quote">
        "In all the world, there is no heart for me like yours. In all the world, there is no love for you like mine."
      </div>
    </div>
  </main>

  <!-- Timeline (Gallery successfully removed) -->
  <section id="page-timeline" class="page-section">
    <div class="timeline-container">
      <div class="timeline-item">
        <div class="timeline-icon">✨</div>
        <div class="timeline-content">
          <div class="timeline-date" id="view-start-date-timeline">August 28, 2026</div>
          <div class="timeline-title">Where it all began</div>
          <div class="timeline-desc">Our paths crossed across a 7500km distance, and our shared timeline began.</div>
        </div>
      </div>
      <div class="timeline-item">
        <div class="timeline-icon">✈️</div>
        <div class="timeline-content">
          <div class="timeline-date">Two-Way Journey</div>
          <div class="timeline-title">Flying Across the World</div>
          <div class="timeline-desc">Every flight through the clouds is just a journey towards that tight embrace... and a shared bowl of Indomie and chips! 🍜🍟</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Updated Bottom Navigation -->
  <nav class="bottom-nav">
    <button class="nav-btn active" data-target="page-home">🕰️ Timer</button>
    <button class="nav-btn" data-target="page-timeline">📜 Journey</button>
  </nav>

  <!-- Settings Modal -->
  <div class="modal-overlay" id="settings-modal">
    <div class="modal-card">
      <div class="modal-title"><span>Edit Details</span><button id="btn-close-modal">&times;</button></div>
      <input type="text" id="input-arabic" class="input-ctrl" dir="rtl" placeholder="Arabic Title (نحن معاً إلى الأبد)">
      <div style="display: flex; gap:10px;"><input type="text" id="input-name1" class="input-ctrl" placeholder="Name 1"><input type="text" id="input-name2" class="input-ctrl" placeholder="Name 2"></div>
      <input type="datetime-local" id="input-date" class="input-ctrl" title="Anniversary Date">
      <input type="file" id="file-bg-input" accept="image/*" class="input-ctrl" title="Upload Background Photo">
      <textarea id="input-quote" class="input-ctrl" rows="2" placeholder="Romantic Quote"></textarea>
      <button class="btn-save" id="btn-save-settings">Save Changes</button>
    </div>
  </div>

  <script>
    const DEFAULT_CONFIG = { arabicTitle: "نحن معاً إلى الأبد", name1: "ala", name2: "jiooo", startDate: "2026-08-28T00:00", quote: "In all the world, there is no heart for me like yours. In all the world, there is no love for you like mine.", bgImage: "" };
    let config = (() => { try { const stored = localStorage.getItem('love_anniv_final_v2'); return stored ? { ...DEFAULT_CONFIG, ...JSON.parse(stored) } : DEFAULT_CONFIG; } catch (e) { return DEFAULT_CONFIG; } })();

    const els = {
      title: document.getElementById('view-arabic-title'), n1: document.getElementById('view-name1'), n2: document.getElementById('view-name2'),
      status: document.getElementById('view-status-title'), days: document.getElementById('view-days'), clock: document.getElementById('view-clock'), 
      quote: document.getElementById('view-quote'), bgLayer: document.getElementById('bg-image-layer'), bgOverlay: document.getElementById('bg-overlay'),
      timeEg: document.getElementById('time-egypt'), timeCn: document.getElementById('time-china')
    };

    // SPA Navigation
    document.querySelectorAll('.nav-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.page-section').forEach(p => p.classList.remove('active'));
        btn.classList.add('active'); document.getElementById(btn.dataset.target).classList.add('active');
      });
    });

    function applyBackground(dataUrl) {
      if (dataUrl) { els.bgLayer.style.backgroundImage = `url('${dataUrl}')`; els.bgLayer.classList.add('has-image'); els.bgOverlay.classList.add('has-image'); } 
      else { els.bgLayer.classList.remove('has-image'); els.bgOverlay.classList.remove('has-image'); }
    }

    function getOrdinal(n) { const s = ["th", "st", "nd", "rd"], v = n % 100; return n + (s[(v - 20) % 10] || s[v] || s[0]); }

    function renderInfo() {
      els.title.textContent = config.arabicTitle; els.n1.textContent = config.name1; els.n2.textContent = config.name2; els.quote.textContent = `"${config.quote}"`;
      const start = new Date(config.startDate); 
      if (!isNaN(start.getTime())) { document.getElementById('view-start-date-timeline').textContent = start.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }); }
      applyBackground(config.bgImage);
    }

    // Dual Time Zones
    function updateDualClocks() {
      const now = new Date();
      els.timeEg.textContent = now.toLocaleTimeString('en-US', { timeZone: 'Africa/Cairo', hour: '2-digit', minute: '2-digit', hour12: true });
      els.timeCn.textContent = now.toLocaleTimeString('en-US', { timeZone: 'Asia/Shanghai', hour: '2-digit', minute: '2-digit', hour12: true });
    }

    // Timer Logic
    function updateTimer() {
      const start = new Date(config.startDate); if (isNaN(start.getTime())) return;
      const now = new Date(); const diffMs = now - start;
      if (diffMs >= 0) {
        const ts = Math.floor(diffMs / 1000); const d = Math.floor(ts / 86400), h = Math.floor((ts % 86400) / 3600), m = Math.floor((ts % 3600) / 60), s = ts % 60;
        els.days.textContent = d; els.clock.textContent = `${String(h).padStart(2,'0')}h ${String(m).padStart(2,'0')}m ${String(s).padStart(2,'0')}s`;
        const next100 = Math.ceil((d + 1) / 100) * 100; 
        document.getElementById('ms-hundred-title').textContent = `Day ${next100} Milestone`; 
        document.getElementById('ms-hundred-val').innerHTML = `In <span>${next100 - d}</span> days`;
        let nextAnniv = new Date(start); nextAnniv.setFullYear(now.getFullYear()); if (nextAnniv <= now) nextAnniv.setFullYear(now.getFullYear() + 1);
        document.getElementById('ms-year-title').textContent = `${getOrdinal(nextAnniv.getFullYear() - start.getFullYear())} Anniversary`; 
        document.getElementById('ms-year-val').innerHTML = `In <span>${Math.ceil((nextAnniv - now) / 86400000)}</span> days`;
      }
    }

    // Settings
    const modal = document.getElementById('settings-modal'); let tempBg = config.bgImage;
    document.getElementById('btn-open-settings').addEventListener('click', () => {
      document.getElementById('input-arabic').value = config.arabicTitle; document.getElementById('input-name1').value = config.name1; document.getElementById('input-name2').value = config.name2;
      document.getElementById('input-date').value = config.startDate; document.getElementById('input-quote').value = config.quote; tempBg = config.bgImage; modal.classList.add('active');
    });
    document.getElementById('btn-close-modal').addEventListener('click', () => modal.classList.remove('active'));
    document.getElementById('file-bg-input').addEventListener('change', (e) => {
      const file = e.target.files[0]; if (!file) return; const reader = new FileReader();
      reader.onload = (evt) => {
        const img = new Image(); img.onload = () => {
          const canvas = document.createElement('canvas'); let w = img.width, h = img.height; const max = 1200;
          if (w > max || h > max) { if (w > h) { h = Math.round(h * max / w); w = max; } else { w = Math.round(w * max / h); h = max; } }
          canvas.width = w; canvas.height = h; canvas.getContext('2d').drawImage(img, 0, 0, w, h); tempBg = canvas.toDataURL('image/jpeg', 0.8);
        }; img.src = evt.target.result;
      }; reader.readAsDataURL(file);
    });
    document.getElementById('btn-save-settings').addEventListener('click', () => {
      config.arabicTitle = document.getElementById('input-arabic').value || "نحن معاً إلى الأبد"; config.name1 = document.getElementById('input-name1').value || "ala"; config.name2 = document.getElementById('input-name2').value || "jiooo";
      config.startDate = document.getElementById('input-date').value || "2026-08-28T00:00"; config.quote = document.getElementById('input-quote').value || "In all the world, there is no heart for me like yours. In all the world, there is no love for you like mine."; config.bgImage = tempBg;
      localStorage.setItem('love_anniv_final_v2', JSON.stringify(config)); renderInfo(); updateTimer(); modal.classList.remove('active');
    });

    // Particles Canvas Animation
    const cvs = document.getElementById('hearts-canvas'), ctx = cvs.getContext('2d');
    let cw = cvs.width = window.innerWidth, ch = cvs.height = window.innerHeight;
    window.addEventListener('resize', () => { cw = cvs.width = window.innerWidth; ch = cvs.height = window.innerHeight; });
    
    class Particle {
      constructor() { this.reset(); }
      reset() { 
        this.x = Math.random() * cw; this.y = ch + Math.random() * 50; 
        this.size = Math.random() * 3 + 1; this.speedY = Math.random() * 0.8 + 0.2; 
        this.color = Math.random() > 0.5 ? 'rgba(201, 16, 38, ' : 'rgba(212, 175, 55, '; 
        this.opacity = Math.random() * 0.5 + 0.2; this.drift = (Math.random() - 0.5) * 0.5;
        
        const types = ['dot', 'dot', 'dot', 'dot', 'dot', '🍜', '🍟', '✨'];
        this.type = types[Math.floor(Math.random() * types.length)];
      }
      update() { this.y -= this.speedY; this.x += this.drift; if (this.y < -20) this.reset(); }
      draw() { 
        if (this.type === 'dot') {
          ctx.beginPath(); ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2); 
          ctx.fillStyle = this.color + this.opacity + ')'; ctx.fill(); 
        } else {
          ctx.font = (this.size * 6) + "px Arial";
          ctx.fillStyle = `rgba(255,255,255, ${this.opacity})`;
          ctx.fillText(this.type, this.x, this.y);
        }
      }
    }
    
    const particles = Array.from({length: 35}, () => new Particle());
    function animate() { ctx.clearRect(0, 0, cw, ch); particles.forEach(p => { p.update(); p.draw(); }); requestAnimationFrame(animate); }

    renderInfo(); updateTimer(); updateDualClocks(); 
    setInterval(updateTimer, 1000); setInterval(updateDualClocks, 60000); 
    animate();
  </script>
</body>
</html>
